// =====================================
// 낮 / 밤 시간 설정
// =====================================

// 하루 전체 길이 (초)
cycle_seconds = 60;

// 낮의 비율
// 2/3 = 낮 40초, 밤 20초
day_ratio = 2 / 3;

// =====================================
// 낮 / 밤 길이 자동 계산
// =====================================

day_length = round(room_speed * cycle_seconds * day_ratio);
night_length = round(room_speed * cycle_seconds * (1 - day_ratio));

// =====================================
// 시작 상태
// =====================================

is_day = true;
day_timer = day_length;